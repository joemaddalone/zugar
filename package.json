{
	"name": "zugar",
	"version": "2.5.1",
	"description": "Zugar is a library for building pipelines for AI-powered applications.",
	"homepage": "https://github.com/joemaddalone/zugar#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joemaddalone/zugar.git"
	},
	"license": "MIT",
	"author": "Joe Maddalone",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"test": "cd src && bun test index.test.ts audio.test.ts",
		"prepack": "tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.16",
		"ai": "^7.0.31",
		"zod": "^4.4.3"
	}
}
